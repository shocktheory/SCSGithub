# SCS Server environment (Phase 3+). Copy to server/.env and fill in.
# NEVER commit the real .env. See SECURITY.md.

APP_ENV=production
APP_URL=https://shocktheoryos.com

# --- MySQL (Nestify) ---
DB_HOST=localhost
DB_NAME=scs
DB_USER=
DB_PASSWORD=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sonja.ross@shocktheory.com

# --- Email provider (decision D5) ---
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=notifications@shocktheoryos.com

# --- Phase 5 (backend foundation & persistence — DEV/TEST ONLY, no production) ---
# In Phase 5, SCS_ENV must be development or test. Production is NOT authorized.
SCS_ENV=development
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=scs_dev;charset=utf8mb4
# Guarded-reset token (dev/test only).
RESET_TOKEN=CONFIRM-RESET
# Derivation engine version stamped onto server-computed derived state.
DERIVATION_VERSION=0.1.0
